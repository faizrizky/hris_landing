{
  "name": "hris-landing",
  "version": "1.0.0",
  "description": "Situs landing promosi HRIS (frontend). Konten diambil dari hris-cms lewat REST API.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "next dev -p 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "sync:types": "cp ../hris-cms/src/payload-types.ts src/payload-types.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@payloadcms/live-preview-react": "3.91.0",
    "@payloadcms/plugin-form-builder": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "geist": "^1.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "0.563.0",
    "motion": "^14.3.0",
    "next": "16.3.3",
    "next-sitemap": "^4.2.3",
    "payload": "3.91.0",
    "prism-react-renderer": "^2.3.1",
    "qs-esm": "^7.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.4.0",
    "yup": "^1.7.1"
