# Alamat publik situs ini (tanpa garis miring di akhir). Dipakai untuk sitemap dan tautan kanonik.
SITE_URL=http://localhost:3000

# Alamat hris-cms yang dipanggil dari server landing, dan alamat yang sama seperti terlihat browser (editor visual).
CMS_URL=http://localhost:3001
CMS_PUBLIC_URL=http://localhost:3001

# Harus sama dengan REVALIDATE_SECRET dan CONTACT_API_KEY di hris-cms (minimal 32 karakter).
REVALIDATE_SECRET=GANTI_DENGAN_RAHASIA_32_KARAKTER_ATAU_LEBIH
CMS_CONTACT_API_KEY=GANTI_DENGAN_RAHASIA_32_KARAKTER_ATAU_LEBIH
