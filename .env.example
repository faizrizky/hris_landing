# URL situs landing ini (tanpa trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL hris-cms (API Payload). Dipanggil dari server landing.
NEXT_PUBLIC_CMS_URL=http://localhost:3001

# Rahasia untuk mengaktifkan preview dan revalidate dari CMS.
# Harus sama dengan PREVIEW_SECRET dan REVALIDATE_SECRET di hris-cms.
PREVIEW_SECRET=GANTI_DENGAN_RAHASIA
REVALIDATE_SECRET=GANTI_DENGAN_RAHASIA
